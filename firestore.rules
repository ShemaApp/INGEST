rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /usuarios/{uid} {
      // El perfil inicial del administrador se crea manualmente desde Firebase Console.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.rol == 'usuario';
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombre', 'telefono', 'actualizadoEn']);
      allow delete: if isAdmin();
    }

    match /_meta/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /configuracion/{documentId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /auditoria/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.immutable == true
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Las colecciones operativas se habilitarán por contrato, no mediante una escritura global.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
